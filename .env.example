# --- Django ---
DJANGO_SECRET_KEY=change-me-to-a-long-random-string
DJANGO_DEBUG=true
DJANGO_ALLOWED_HOSTS=192.168.1.218,127.0.0.1,localhost
DJANGO_DB_ENGINE=django.db.backends.sqlite3
DJANGO_DB_NAME=db.sqlite3

# Email: console = printed in the runserver terminal (no real inbox). Use SMTP in production.
DJANGO_EMAIL_BACKEND=django.core.mail.backends.console.EmailBackend
DEFAULT_FROM_EMAIL=LoanWise <noreply@example.com>
FRONTEND_BASE_URL=http://127.0.0.1:8000

# CORS (comma-separated origins)
CORS_ALLOWED_ORIGINS=http://127.0.0.1:8000,http://localhost:8000

# --- LoanWise business ---
LOANWISE_CURRENCY=EUR
LOANWISE_INTEREST_RATE_ANNUAL=0.05
LOANWISE_APPROVAL_THRESHOLD=55
LOANWISE_DELETE_FILES_AFTER_ANALYSIS=true

# Florence-2 document vision (optional; pip install -r requirements-ai.txt). Default: off.
# LOANWISE_ENABLE_FLORENCE=true

# LLM + RAG rule extraction + document vision (set key in .env only; never commit)
# LLM: none | openai
LOANWISE_LLM_PROVIDER=none
LOANWISE_OPENAI_MODEL=gpt-4o-mini
# Optional if you set the key in Admin → Integration settings (OpenAI)
OPENAI_API_KEY=
# Optional: gpt-4o for harder documents
# LOANWISE_OPENAI_VISION_MODEL=gpt-4o-mini
# Document images: auto (OpenAI if key set) | openai | florence | fallback
# LOANWISE_DOCUMENT_ANALYSIS_BACKEND=auto

# LangGraph bridge (optional)
LOANWISE_USE_LANGGRAPH=false

# Install optional ML/AI packages: pip install -r requirements-ai.txt

# Email verification (orchestrator): in development (DEBUG=true) the pipeline does NOT require a verified email by default.
# LOANWISE_REQUIRE_EMAIL_VERIFICATION=true
# LOANWISE_AUTO_VERIFY_EMAIL_IN_DEBUG=false
